{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "lib": ["ES2022", "ESNext.Promise", "DOM", "DOM.Iterable"]
  },
  "include": ["core.ts", "examples/**/*.ts", "index.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
